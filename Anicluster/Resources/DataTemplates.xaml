<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Anicluster.ViewModels"
                    xmlns:views="clr-namespace:Anicluster.Views">

    <!-- Ordnet jedem ViewModel seine View zu -->

    <!-- Seiten im Hauptfenster -->
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
        <views:LibraryView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnimeEditorViewModel}">
        <views:AnimeEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TagManagerViewModel}">
        <views:TagManagerView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TagNetworkViewModel}">
        <views:TagNetworkView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnimeNetworkViewModel}">
        <views:AnimeNetworkView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TasteProfileViewModel}">
        <views:TasteProfileView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TimelineViewModel}">
        <views:TimelineView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView/>
    </DataTemplate>

    <!-- Einträge und Teile -->
    <DataTemplate DataType="{x:Type vm:AnimeListItemViewModel}">
        <views:AnimeListItemView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ColorEditorViewModel}">
        <views:ColorEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MusicPieceViewModel}">
        <views:MusicPieceView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SyncroViewModel}">
        <views:SyncroView/>
    </DataTemplate>

    <!-- Dialoge -->
    <DataTemplate DataType="{x:Type vm:QuickAnimeViewModel}">
        <views:QuickAnimeView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RatingEditorViewModel}">
        <views:RatingEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SeasonEditorViewModel}">
        <views:SeasonEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:VideoAnimationEditorViewModel}">
        <views:VideoAnimationEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PublishingTimeEditorViewModel}">
        <views:PublishingTimeEditorView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MetadataImportViewModel}">
        <views:MetadataImportView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TagSelectionViewModel}">
        <views:TagSelectionView/>
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SqlConsoleViewModel}">
        <views:SqlConsoleView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NumberInputViewModel}">
        <views:NumberInputView/>
    </DataTemplate>
</ResourceDictionary>
