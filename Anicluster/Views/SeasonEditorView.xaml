<UserControl x:Class="Anicluster.Views.SeasonEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SeasonEditorViewModel}"
             MinWidth="800"
             MinHeight="420"
             d:DesignHeight="420"
             d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Liste der Staffeln: Entf löscht, Drag & Drop sortiert um -->
        <ListView x:Name="ListViewSeasons"
                  Margin="10"
                  Grid.Column="0"
                  ItemsSource="{Binding Seasons}"
                  SelectedItem="{Binding SelectedSeason}"
                  KeyDown="ListViewSeasons_KeyDown"
                  AllowDrop="True"
                  Drop="ListViewSeasons_Drop"
                  DragOver="ListViewSeasons_DragOver"
                  PreviewMouseLeftButtonDown="ListViewSeasons_PreviewMouseLeftButtonDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Nr."
                                    Width="25">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Number}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Episoden"
                                    Width="55">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Episodes.Count}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Startjahr"
                                    Width="75">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PublishingTime.DisplayStartYear}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Endjahr"
                                    Width="75">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding PublishingTime.DisplayEndYear}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Kommentar"
                                    Width="200">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Comment}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Eingabe einer neuen Staffel -->
        <Grid Grid.Column="1"
              Margin="5,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0"
                   Content="Anzahl der Episoden*"
                   FontWeight="Bold"/>
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="5,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding EpisodeCountText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.HelpText="Anzahl der Episoden in Zahlen"/>
            <Label Grid.Row="1"
                   Content="Startjahr"
                   FontWeight="Bold"/>
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="5,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding StartYearText, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="2"
                   Content="Endjahr"
                   FontWeight="Bold"/>
            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Margin="5,3"
                     VerticalContentAlignment="Center"
                     Text="{Binding EndYearText, UpdateSourceTrigger=PropertyChanged}"/>
            <Label Grid.Row="3"
                   Grid.ColumnSpan="2"
                   Content="Kommentar"
                   FontWeight="Bold"/>
            <TextBox Grid.Row="4"
                     Grid.ColumnSpan="2"
                     Margin="5,0,5,5"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Content="Hinzufügen"
                    Margin="55,0"
                    Height="25"
                    Click="BtnAdd_Click"/>
        </Grid>

        <!-- Übernehmen / Abbrechen -->
        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,0,10,10">
            <Button Content="Übernehmen"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Click="BtnAccept_Click"/>
            <Button Content="Abbrechen"
                    MinWidth="100"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
