<UserControl x:Class="Anicluster.Views.SeasonEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SeasonEditorViewModel}"
             MinWidth="900"
             MinHeight="480"
             d:DesignHeight="480"
             d:DesignWidth="900">
    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Vorhandene Staffeln: per Drag & Drop sortieren, Entf löscht die markierte Staffel -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="GridSeasons"
                          ItemsSource="{Binding Seasons}"
                          SelectedItem="{Binding SelectedSeason}"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          KeyDown="GridSeasons_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr." Binding="{Binding Number}" Width="60"/>
                        <DataGridTextColumn Header="Episoden" Binding="{Binding Episodes.Count}" Width="90"/>
                        <DataGridTextColumn Header="Start" Binding="{Binding PublishingTime.DisplayStartYear}" Width="80"/>
                        <DataGridTextColumn Header="Ende" Binding="{Binding PublishingTime.DisplayEndYear}" Width="80"/>
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="1"
                       Text="Zeilen per Drag &amp; Drop sortieren, Entf löscht die markierte Staffel."
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="2,8,0,0"/>
        </Grid>

        <!-- Neue Staffel -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Neue Staffel" Style="{StaticResource SectionTitle}"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Anzahl der Episoden *" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding EpisodeCountText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Startjahr" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding StartYearText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Endjahr" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding EndYearText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>
                <TextBlock Grid.Row="3" Text="Kommentar" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="4"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,14"/>
                <Button Grid.Row="5" Content="Hinzufügen" Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <!-- Übernehmen / Abbrechen -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Abbrechen" MinWidth="120" Click="BtnCancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Übernehmen"
                    MinWidth="140"
                    Margin="10,0,0,0"
                    Click="BtnAccept_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
