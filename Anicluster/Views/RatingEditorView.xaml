<UserControl x:Class="Anicluster.Views.RatingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Anicluster.Views"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             xmlns:wf="clr-namespace:WpfMath.Controls;assembly=WpfMath"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RatingEditorViewModel}"
             MinWidth="680"
             MinHeight="600"
             d:DesignHeight="600"
             d:DesignWidth="680">
    <Grid Margin="24,16,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <!-- Auswertung -->
            <TabItem Header="Auswertung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,20,4,4">
                        <TextBlock Text="Berechnung" Style="{StaticResource FieldLabel}"/>
                        <wf:FormulaControl Scale="18"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,22"
                                           Foreground="{DynamicResource TextBrush}"
                                           Formula="\frac{Ge \cdot 40 + An \cdot 25 + SE \cdot 10 + A.G \cdot 25}{100}"/>
                        <TextBlock Text="Aktuelle Eingabe" Style="{StaticResource FieldLabel}"/>
                        <wf:FormulaControl Scale="18"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,22"
                                           Foreground="{DynamicResource TextBrush}"
                                           Formula="{Binding FormulaText}"/>
                        <TextBlock Text="Legende" Style="{StaticResource FieldLabel}"/>
                        <wf:FormulaControl Scale="15"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,22"
                                           Foreground="{DynamicResource TextBrush}"
                                           Formula="Ge = \text{Geschichte}, An = \text{Animation}, SE = \text{Spezialeffekte}\\A.G = \text{Akustik gesammt, besteht mindestens aus der Soundtrack-}\\\text{         gesamtbewertung oder berechnet sich aus den Opening(s),}\\\text{         Ending(s), Syncro(s) und eingetragenen einzelnen}\\\text{         Soundtracks.}"/>
                        <TextBlock Text="Hinweis: Die Bewertung 0 in einem der Pflichtbereiche (mit * markiert) fließt als Faktor mit ein! Einträge entfernst du mit dem ✕ am jeweiligen Eintrag."
                                   Style="{StaticResource MutedText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Bereiche -->
            <TabItem Header="Bereiche">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,20,0,4">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Allgemein" Style="{StaticResource SectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Geschichte *" VerticalAlignment="Center"/>
                                    <views:ScoreBarView Grid.Row="0" Grid.Column="1" DataContext="{Binding Story}"/>
                                    <TextBlock Grid.Row="1" Text="Animation *" VerticalAlignment="Center"/>
                                    <views:ScoreBarView Grid.Row="1" Grid.Column="1" DataContext="{Binding Animation}"/>
                                    <TextBlock Grid.Row="2" Text="Spezialeffekte *" VerticalAlignment="Center"/>
                                    <views:ScoreBarView Grid.Row="2" Grid.Column="1" DataContext="{Binding SpecialEffects}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Akustik" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Soundtrack *" VerticalAlignment="Center"/>
                                    <views:ScoreBarView Grid.Column="1" DataContext="{Binding Soundtrack}"/>
                                </Grid>
                                <Button Content="Soundtracks einzeln bewerten und berechnen"
                                        HorizontalAlignment="Left"
                                        Click="BtnSoundtrackCalculate_Click"/>
                                <Separator Margin="0,16"/>
                                <TextBlock Text="Akustik gesamt" Style="{StaticResource FieldLabel}"
                                           ToolTip="Die Akustik berechnet sich aus gleichen Teilen von Opening, Ending, bewerteten Syncros und dem Soundtrack-Wert (durch 4, sonst entsprechend weniger)."/>
                                <TextBlock Text="{Binding AcousticSummaryText}" FontSize="15" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Listen -->
            <TabItem Header="Soundtrack">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SoundtrackPieces}"/>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+  Soundtrack hinzufügen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnSoundtrackAdd_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Opening(s)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Openings}"/>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+  Opening hinzufügen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnOpeningAdd_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Ending(s)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Endings}"/>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+  Ending hinzufügen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnEndingAdd_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="Syncro(s)">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Syncros}"/>
                    </ScrollViewer>
                    <Button Grid.Row="1" Content="+  Syncronisation hinzufügen" HorizontalAlignment="Left" Margin="0,8,0,0" Click="BtnSyncroAdd_Click"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Abbrechen" MinWidth="120" Click="BtnCancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Bewertung übernehmen"
                    MinWidth="190"
                    Margin="10,0,0,0"
                    Click="BtnAccept_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
