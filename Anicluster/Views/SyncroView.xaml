<UserControl x:Class="Anicluster.Views.SyncroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Anicluster.Views"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SyncroViewModel}"
             d:DesignWidth="520">
    <!-- Eine Syncro im Bewertungsdialog -->
    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16">
        <StackPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding Languages}"
                          DisplayMemberPath="Value"
                          SelectedValuePath="Key"
                          SelectedValue="{Binding Language}"/>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButton}"
                        Content="&#xE711;"
                        ToolTip="Eintrag entfernen"
                        Margin="8,0,0,0"
                        Click="BtnRemoveEntry_Click"/>
            </Grid>
            <views:ScoreBarView DataContext="{Binding Score}" Margin="0,0,0,6"/>
            <CheckBox Content="Wird bewertet"
                      IsChecked="{Binding IsAssessed}"
                      Margin="0,0,0,10"/>
            <Grid>
                <TextBox x:Name="TbComment"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         MinHeight="60"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"/>
                <TextBlock Text="Kommentar …"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="11,8,0,0"
                           VerticalAlignment="Top"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=TbComment, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
