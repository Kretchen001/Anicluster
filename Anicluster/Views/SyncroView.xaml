<UserControl x:Class="Anicluster.Views.SyncroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Anicluster.Views"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SyncroViewModel}"
             d:DesignHeight="175"
             d:DesignWidth="250">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Eintrag entfernen"
                      Click="BtnRemoveEntry_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border Style="{StaticResource RoundedBorder}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6">Sprache:</TextBlock>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Margin="0,0,0,5"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding Language}"/>
                    <Button Grid.Column="1"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-2,-5,0"
                            Template="{StaticResource buttonCrossTemplate}"
                            Click="BtnRemoveEntry_Click"/>
                </Grid>
            </Grid>
            <views:ScoreBarView DataContext="{Binding Score}"
                                Margin="0,0,0,2"/>
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                <TextBlock Margin="0,0,5,0">
                    Wird bewertet?
                </TextBlock>
                <CheckBox HorizontalAlignment="Right"
                          IsChecked="{Binding IsAssessed}"/>
            </StackPanel>
            <Grid>
                <TextBox x:Name="TbComment"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         ToolTip="Kommentarfeld"/>
                <TextBlock Text="Kommentar hier eingeben..."
                           Foreground="LightGray"
                           Margin="5,3,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Visibility="{Binding Text, ElementName=TbComment, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
