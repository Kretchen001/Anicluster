<UserControl x:Class="Anicluster.Views.TagNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             xmlns:views="clr-namespace:Anicluster.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagNetworkViewModel}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="780"
             d:DesignWidth="1250">
    <UserControl.Resources>
        <!-- Position und Sichtbarkeit eines Knotens auf der Zeichenfläche -->
        <Style x:Key="NodeContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
            <Setter Property="Visibility" Value="{Binding IsVisibleInGraph, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Style>

        <!-- Treffer in der Seitenleiste: Tier-Farbe, Name und Status, Doppelklick öffnet den Anime -->
        <DataTemplate x:Key="ResultTemplate">
            <Border Padding="8,7"
                    CornerRadius="8"
                    Cursor="Hand"
                    ToolTip="Doppelklick öffnet den Anime"
                    MouseLeftButtonDown="Result_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26" Height="22"
                            CornerRadius="6"
                            Margin="0,0,10,0"
                            Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}">
                        <TextBlock Text="{Binding TierText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Tier, Converter={StaticResource TierBrushConverter}, ConverterParameter=Text}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Ellipse Grid.Column="2"
                             Width="9" Height="9"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             ToolTip="{Binding StateText}"
                             Fill="{Binding State, Converter={StaticResource StateBrushConverter}}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Tag-Netzwerk" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding VisibleCountText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom"
                           Margin="14,0,0,5"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Neu anordnen" Click="BtnRelayout_Click"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- Netzwerk: je häufiger ein Tag, desto größer die Schrift. Je öfter zwei Tags gemeinsam vorkommen, desto näher liegen sie beieinander. -->
            <Border x:Name="ViewportHost"
                    Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    ClipToBounds="True"
                    SizeChanged="ViewportHost_SizeChanged">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="WorldHost"
                              Width="{Binding WorldWidth}"
                              Height="{Binding WorldHeight}"
                              Background="Transparent"
                              MouseLeftButtonDown="World_MouseLeftButtonDown">
                            <views:TagEdgeLayer x:Name="EdgeLayer"
                                                Edges="{Binding Edges}"
                                                IsHitTestVisible="False"/>
                            <ItemsControl ItemsSource="{Binding Nodes}"
                                          ItemContainerStyle="{StaticResource NodeContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Chip"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                BorderBrush="{DynamicResource EdgeBrush}"
                                                BorderThickness="1.5"
                                                CornerRadius="18"
                                                Padding="14,5"
                                                Cursor="Hand"
                                                ToolTip="{Binding Count, StringFormat='{}{0}× vergeben'}"
                                                MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                                MouseMove="Node_MouseMove"
                                                MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                                MouseEnter="Node_MouseEnter"
                                                MouseLeave="Node_MouseLeave">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Tag ausblenden" Click="NodeMenuHide_Click"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <TextBlock x:Name="Label"
                                                       Text="{Binding Designation}"
                                                       FontSize="{Binding FontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                <Setter TargetName="Chip" Property="Opacity" Value="0.25"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                    <TextBlock Text="Es sind noch keine Tags vorhanden."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Seitenleiste: Auswahl, Treffer und Tags ein-/ausschalten -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Auswahl" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Klick wählt einen Tag, Strg + Klick mehrere. Ziehen verschiebt, Rechtsklick blendet aus."
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding SelectedNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TagChip}" Padding="12,2,2,2">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Designation}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Button Content="✕"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="7,3"
                                                        FontSize="11"
                                                        ToolTip="Aus der Auswahl entfernen"
                                                        Click="BtnRemoveSelected_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,4,0,8"
                                       Visibility="{Binding HasMultipleSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Alle Tags (UND)"
                                             IsChecked="{Binding MatchMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TagMatchMode.All}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Ein Tag genügt (ODER)"
                                             IsChecked="{Binding MatchMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TagMatchMode.Any}}"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Content="In Bibliothek anzeigen"
                                        Margin="0,0,8,0"
                                        IsEnabled="{Binding HasSelection}"
                                        Click="BtnShowInLibrary_Click"/>
                                <Button Content="Auswahl aufheben"
                                        IsEnabled="{Binding HasSelection}"
                                        Click="BtnClearSelection_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Treffer" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding ResultsText}"
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Results}"
                                              ItemTemplate="{StaticResource ResultTemplate}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Tags ein- und ausschalten" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,12">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="38,6,10,6"/>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Tags suchen …"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="39,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Mindesthäufigkeit:"/>
                                <Run Text="{Binding MinCount, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Slider Minimum="0"
                                    Maximum="{Binding MaxCount}"
                                    Value="{Binding MinCount}"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Margin="0,0,0,12"/>
                            <WrapPanel Margin="0,0,0,8">
                                <Button Content="Alle an" Margin="0,0,8,0" Click="BtnEnableAll_Click"/>
                                <Button Content="Alle aus" Click="BtnDisableAll_Click"/>
                            </WrapPanel>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ListNodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid x:Name="Row" Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Content="{Binding Designation}"
                                                          IsChecked="{Binding IsEnabled}"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Count}"
                                                           Style="{StaticResource MutedText}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsBelowMinimum}" Value="True">
                                                    <Setter TargetName="Row" Property="Opacity" Value="0.45"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
