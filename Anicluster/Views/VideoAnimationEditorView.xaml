<UserControl x:Class="Anicluster.Views.VideoAnimationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VideoAnimationEditorViewModel}"
             MinWidth="860"
             MinHeight="460"
             d:DesignHeight="460"
             d:DesignWidth="860">
    <Grid Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Vorhandene Einträge: per Drag & Drop sortieren, Entf löscht den markierten Eintrag -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <DataGrid x:Name="GridVideos"
                          ItemsSource="{Binding Videos}"
                          SelectedItem="{Binding SelectedVideo}"
                          IsReadOnly="True"
                          CanUserSortColumns="False"
                          CanUserResizeColumns="False"
                          CanUserReorderColumns="False"
                          KeyDown="GridVideos_KeyDown">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nr." Binding="{Binding Id}" Width="60"/>
                        <DataGridTextColumn Header="Typ" Binding="{Binding VideoType}" Width="110"/>
                        <DataGridTextColumn Header="Kommentar" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Grid.Row="1"
                       Text="Zeilen per Drag &amp; Drop sortieren, Entf löscht den markierten Eintrag."
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       Margin="2,8,0,0"/>
        </Grid>

        <!-- Neuer Eintrag -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Neuer Eintrag" Style="{StaticResource SectionTitle}"/>
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="Typ" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding VideoTypes}" SelectedItem="{Binding SelectedType}"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Text="Kommentar" Style="{StaticResource FieldLabel}"/>
                <TextBox Grid.Row="3"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         Margin="0,0,0,14"/>
                <Button Grid.Row="4" Content="Hinzufügen" Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <!-- Übernehmen / Abbrechen -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Abbrechen" MinWidth="120" Click="BtnCancel_Click"/>
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Übernehmen"
                    MinWidth="140"
                    Margin="10,0,0,0"
                    Click="BtnAccept_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
