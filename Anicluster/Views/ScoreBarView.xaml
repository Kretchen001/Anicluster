<UserControl x:Class="Anicluster.Views.ScoreBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ScoreViewModel}"
             d:DesignHeight="24"
             d:DesignWidth="250">
    <!-- Bewertungsbalken: Mausrad ändert den Wert, ein Klick öffnet die Zahleneingabe. DataContext ist ein ScoreViewModel. -->
    <Grid>
        <ProgressBar Maximum="100"
                     Height="24"
                     Margin="3"
                     Value="{Binding Value, Mode=OneWay}"
                     ToolTip="Bewertung, bitte klicken und Zahlen eingeben oder Mausrad verwenden"
                     MouseWheel="ProgressBar_MouseWheel"
                     MouseLeftButtonDown="ProgressBar_MouseLeftButtonDown"
                     Foreground="{Binding Value, RelativeSource={RelativeSource Self}, Converter={StaticResource SmoothProgressBarColorConverter}}"/>
        <Label Content="{Binding Value}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               IsHitTestVisible="False"
               Foreground="Black"
               Background="Transparent"/>
    </Grid>
</UserControl>
