<UserControl x:Class="Anicluster.Views.AnimeNetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             xmlns:views="clr-namespace:Anicluster.Views"
             xmlns:an="clr-namespace:Anicluster.AnimeNetwork"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnimeNetworkViewModel}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="780"
             d:DesignWidth="1250">
    <UserControl.Resources>
        <!-- Position und Sichtbarkeit eines Knotens auf der Zeichenfläche -->
        <Style x:Key="NodeContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
            <Setter Property="Canvas.Top" Value="{Binding Top}"/>
            <Setter Property="Visibility" Value="{Binding IsVisibleInGraph, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Style>

        <!-- Hinweistext, der verschwindet, sobald ein Anime gewählt ist -->
        <Style x:Key="HintWithoutSelectionStyle" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Verbundener Anime in der Seitenleiste: Tier, Name und Art der Verbindung. Klick wählt ihn aus. -->
        <DataTemplate x:Key="NeighborTemplate">
            <Border Padding="8,7"
                    CornerRadius="8"
                    Cursor="Hand"
                    ToolTip="Klick wählt den Anime"
                    MouseLeftButtonDown="Neighbor_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="26" Height="22"
                            CornerRadius="6"
                            Margin="0,0,10,0"
                            Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}">
                        <TextBlock Text="{Binding TierText}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Tier, Converter={StaticResource TierBrushConverter}, ConverterParameter=Text}"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding DetailText}"
                               Style="{StaticResource MutedText}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Anime-Netzwerk" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding InfoText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom"
                           Margin="14,0,0,5"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Neu anordnen" Click="BtnRelayout_Click"/>
        </Grid>

        <!-- Netzwerkart -->
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
            <WrapPanel>
                <RadioButton Style="{StaticResource ChipStyle}"
                             Content="Vorgänger und Nachfolger"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static an:AnimeNetworkMode.Relations}}"/>
                <RadioButton Style="{StaticResource ChipStyle}"
                             Content="Ähnliche Tags"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static an:AnimeNetworkMode.Tags}}"/>
                <RadioButton Style="{StaticResource ChipStyle}"
                             Content="Ähnliche Bewertung"
                             IsChecked="{Binding Mode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static an:AnimeNetworkMode.Ratings}}"/>
            </WrapPanel>
            <TextBlock Text="{Binding ModeDescription}"
                       Style="{StaticResource MutedText}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="370"/>
            </Grid.ColumnDefinitions>

            <!-- Netzwerk: verbundene Animes rücken zusammen, Cluster liegen auf einer gemeinsamen Fläche. Das Mausrad zoomt zum Mauszeiger, Ziehen auf freier Fläche verschiebt den Ausschnitt. -->
            <Border Grid.Column="0"
                    Style="{StaticResource Card}"
                    Padding="0"
                    ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="ViewportHost"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  SizeChanged="ViewportHost_SizeChanged"
                                  PreviewMouseWheel="ViewportHost_PreviewMouseWheel">
                        <Viewbox Stretch="Uniform"
                                 Width="{Binding ViewWidth}"
                                 Height="{Binding ViewHeight}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top">
                            <Grid x:Name="WorldHost"
                                  Width="{Binding WorldWidth}"
                                  Height="{Binding WorldHeight}"
                                  Background="Transparent"
                                  MouseLeftButtonDown="World_MouseLeftButtonDown"
                                  MouseMove="World_MouseMove"
                                  MouseLeftButtonUp="World_MouseLeftButtonUp">
                                <views:AnimeEdgeLayer x:Name="EdgeLayer"
                                                      Edges="{Binding Edges}"
                                                      Clusters="{Binding Clusters}"
                                                      IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding Nodes}"
                                              ItemContainerStyle="{StaticResource NodeContainerStyle}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Chip"
                                                    Background="{DynamicResource SurfaceAltBrush}"
                                                    BorderBrush="{DynamicResource EdgeBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="15"
                                                    Padding="8,4,10,4"
                                                    Cursor="Hand"
                                                    ToolTip="{Binding Name}"
                                                    MouseLeftButtonDown="Node_MouseLeftButtonDown"
                                                    MouseMove="Node_MouseMove"
                                                    MouseLeftButtonUp="Node_MouseLeftButtonUp"
                                                    MouseEnter="Node_MouseEnter"
                                                    MouseLeave="Node_MouseLeave">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="10" Height="10"
                                                             Margin="0,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Fill="{Binding Tier, Converter={StaticResource TierBrushConverter}}"/>
                                                    <TextBlock x:Name="Label"
                                                               Text="{Binding DisplayName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="&#x2605;"
                                                               FontSize="12"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="#F5B301"
                                                               Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsLinked}" Value="False">
                                                    <Setter TargetName="Chip" Property="Opacity" Value="0.65"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                                                    <Setter TargetName="Chip" Property="Opacity" Value="0.2"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </ScrollViewer>
                    <TextBlock Text="{Binding EmptyText}"
                               Style="{StaticResource MutedText}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               MaxWidth="420"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Seitenleiste: Einstellungen, Auswahl und Verbindungen des gewählten Animes -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,6,0">

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Darstellung" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Klick wählt einen Anime, Doppelklick öffnet ihn, Ziehen verschiebt den Anime. Das Mausrad zoomt zum Mauszeiger, Ziehen auf freier Fläche verschiebt den Ausschnitt."
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <!-- Ähnlichkeit: nur bei Tags und Bewertung -->
                            <StackPanel Visibility="{Binding IsSimilarityMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Mindestähnlichkeit:"/>
                                    <Run Text="{Binding SimilarityPercent, Mode=OneWay, StringFormat='{}{0} %'}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <Slider Minimum="0"
                                        Maximum="100"
                                        Value="{Binding SimilarityPercent, Delay=200}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,0,12"/>
                                <TextBlock Style="{StaticResource FieldLabel}">
                                    <Run Text="Nachbarn pro Anime (höchstens):"/>
                                    <Run Text="{Binding NeighborCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                                <Slider Minimum="1"
                                        Maximum="15"
                                        Value="{Binding NeighborCount, Delay=200}"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Margin="0,0,0,12"/>
                            </StackPanel>

                            <CheckBox Content="Animes ohne Verbindung anzeigen"
                                      IsChecked="{Binding ShowUnlinked}"
                                      Margin="0,0,0,12"/>

                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <WrapPanel Margin="0,0,0,4">
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Alle"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.All}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Wunschliste"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.Wishlist}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Begonnen"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.Started}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Beendet"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.Finished}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Unterbrochen"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.Interrupted}}"/>
                                <RadioButton Style="{StaticResource ChipStyle}" Content="Abgebrochen"
                                             IsChecked="{Binding StatusFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:LibraryStatusFilter.Canceled}}"/>
                            </WrapPanel>

                            <Grid Margin="0,4,0,4">
                                <TextBox x:Name="SearchBox"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="38,6,10,6"/>
                                <TextBlock Text="&#xE721;"
                                           FontFamily="{StaticResource IconFont}"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBlock Text="Anime hervorheben …"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="39,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </Grid>
                            <TextBlock Text="{Binding SearchResultText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       Margin="0,0,0,8"/>

                            <TextBlock Style="{StaticResource FieldLabel}" Margin="0,8,0,5">
                                <Run Text="Zoom:"/>
                                <Run Text="{Binding ZoomText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Slider Minimum="1"
                                    Maximum="8"
                                    Value="{Binding Zoom}"
                                    SmallChange="0.25"
                                    LargeChange="1"/>
                            <Button Content="Einpassen"
                                    HorizontalAlignment="Left"
                                    Margin="0,6,0,0"
                                    ToolTip="Zeigt das ganze Netzwerk"
                                    Click="BtnZoomReset_Click"/>

                            <TextBlock Text="{Binding HintText}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,12,0,0"
                                       Visibility="{Binding HasHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Auswahl" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                            <TextBlock Text="Wähle im Netzwerk einen Anime aus, um seine Verbindungen zu sehen."
                                       Style="{StaticResource HintWithoutSelectionStyle}"/>
                            <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="26" Height="22"
                                            CornerRadius="6"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            Background="{Binding SelectedItem.Tier, Converter={StaticResource TierBrushConverter}}">
                                        <TextBlock Text="{Binding SelectedItem.TierText}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding SelectedItem.Tier, Converter={StaticResource TierBrushConverter}, ConverterParameter=Text}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding SelectedItem.Name}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Ellipse Width="9" Height="9"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding SelectedItem.State, Converter={StaticResource StateBrushConverter}}"/>
                                            <TextBlock Text="{Binding SelectedItem.StateText}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding SelectedTagsText}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedRatingText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedClusterText}"
                                           Style="{StaticResource MutedText}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Content="Anime öffnen"
                                            Margin="0,0,8,8"
                                            Click="BtnOpenSelected_Click"/>
                                    <Button Content="In Bibliothek suchen"
                                            Margin="0,0,8,8"
                                            Click="BtnSearchInLibrary_Click"/>
                                    <Button Content="Auswahl aufheben"
                                            Margin="0,0,0,8"
                                            Click="BtnClearSelection_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="Verbunden mit" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding NeighborsText}"
                                       Style="{StaticResource MutedText}"
                                       Margin="0,0,0,8"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Neighbors}"
                                              ItemTemplate="{StaticResource NeighborTemplate}"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
