<UserControl x:Class="Anicluster.Views.PublishingTimeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PublishingTimeEditorViewModel}"
             MinWidth="600"
             MinHeight="390"
             d:DesignHeight="390"
             d:DesignWidth="600">
    <StackPanel Margin="5">
        <GroupBox Header="Produktionsdaten">
            <UniformGrid>
                <TextBlock Text="Startdatum"
                           VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding StartDate}"
                            Margin="0,0,0,2"
                            FirstDayOfWeek="Monday"/>
                <TextBlock Text="Enddatum"
                           VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding EndDate}"
                            FirstDayOfWeek="Monday"/>
            </UniformGrid>
        </GroupBox>
        <GroupBox Header="Unterbrechungen"
                  Height="225">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0"
                             Columns="2">
                    <TextBlock Text="Startdatum"
                               VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding NewInterruptionStart}"
                                Margin="0,0,0,2"
                                FirstDayOfWeek="Monday"/>
                    <TextBlock Text="Enddatum"
                               VerticalAlignment="Center"/>
                    <DatePicker SelectedDate="{Binding NewInterruptionEnd}"
                                FirstDayOfWeek="Monday"/>
                </UniformGrid>
                <Button Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="5"
                        Click="BtnAddInterruption_Click">
                    Hinzufügen
                </Button>
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Interruptions}"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Startdatum"
                                            Binding="{Binding Start}"
                                            Width="auto"/>
                        <DataGridTextColumn Header="Enddatum"
                                            Binding="{Binding End}"
                                            Width="auto"/>
                        <DataGridTextColumn Header="Kommentar"
                                            Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,5,5">
            <Button Content="Übernehmen"
                    MinWidth="100"
                    Margin="0,0,10,0"
                    Click="BtnAccept_Click"/>
            <Button Content="Abbrechen"
                    MinWidth="100"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</UserControl>
