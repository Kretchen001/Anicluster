<UserControl x:Class="Anicluster.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="780"
             d:DesignWidth="1250">
    <UserControl.Resources>
        <!-- Position eines Elements auf einer Canvas-Zeichenfläche (Balken, Pausen, Jahresmarken) -->
        <Style x:Key="LeftContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
        </Style>

        <!-- Balken: Farbe nach Tier, bei „Nach Status“ nach dem Status des Animes -->
        <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:TimelineBarViewModel}">
            <Border Width="{Binding Width}"
                    Height="18"
                    CornerRadius="5"
                    Margin="0,7,0,0"
                    ToolTip="{Binding Tooltip}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding Tier, Converter={StaticResource TierBrushConverter}}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ColorByTier}" Value="False">
                                <Setter Property="Background" Value="{Binding State, Converter={StaticResource StateBrushConverter}}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!-- Pause: überdeckt den Balken mit der Kartenfarbe -->
        <DataTemplate x:Key="GapTemplate">
            <Border Width="{Binding Width}"
                    Height="18"
                    Margin="0,7,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    Opacity="0.85"/>
        </DataTemplate>

        <!-- Zeile des Zeitstrahls, Doppelklick öffnet den Anime -->
        <DataTemplate x:Key="TimelineRowTemplate" DataType="{x:Type vm:TimelineRowViewModel}">
            <Border Height="32"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ItemsControl ItemsSource="{Binding Bars}"
                                  ItemTemplate="{StaticResource BarTemplate}"
                                  ItemContainerStyle="{StaticResource LeftContainerStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Gaps}"
                                  ItemTemplate="{StaticResource GapTemplate}"
                                  ItemContainerStyle="{StaticResource LeftContainerStyle}"
                                  IsHitTestVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Name links neben dem Zeitstrahl -->
        <DataTemplate x:Key="NameTemplate" DataType="{x:Type vm:TimelineRowViewModel}">
            <Border Height="32"
                    Padding="14,0,10,0"
                    ToolTip="Doppelklick öffnet den Anime"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel und Bedienung -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Zeitstrahl" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding InfoText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom"
                           Margin="14,0,0,5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBox Width="200"
                         Margin="0,0,16,0"
                         VerticalAlignment="Center"
                         ToolTip="Nach Namen filtern"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <ToggleButton Content="Farbe: Tier"
                              Style="{StaticResource ChipStyle}"
                              Margin="0,0,8,0"
                              IsChecked="{Binding ColorByTier}"/>
                <ToggleButton Content="Farbe: Status"
                              Style="{StaticResource ChipStyle}"
                              Margin="0,0,16,0"
                              IsChecked="{Binding ColorByState}"/>
                <TextBlock Text="Zoom" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Width="160"
                        VerticalAlignment="Center"
                        Minimum="20" Maximum="400"
                        Value="{Binding PixelsPerYear}"
                        ToolTip="Breite eines Jahres (auch Strg + Mausrad)"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,18,0,0" ClipToBounds="True">
            <Grid>
                <!-- Hinweis, wenn nichts angezeigt werden kann -->
                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="24"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Kopfzeile, Namen und Zeitachse laufen synchron: Der Hauptbereich scrollt in beide Richtungen,
                     Jahresleiste und Namen folgen ihm (siehe Code-Behind). Beide Scrollbalken sind immer sichtbar. -->
                <Grid Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>

                    <!-- Jahresleiste; rechts bleibt Platz für den senkrechten Scrollbalken des Hauptbereichs -->
                    <ScrollViewer x:Name="HeaderScroll"
                                  Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,17,0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <Border Width="{Binding Width}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding Ticks}" ItemContainerStyle="{StaticResource LeftContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   Margin="6,6,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>

                    <!-- Namen; unten bleibt Platz für den waagerechten Scrollbalken des Hauptbereichs -->
                    <ScrollViewer x:Name="NamesScroll"
                                  Grid.Row="1" Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  PreviewMouseWheel="NamesScroll_PreviewMouseWheel">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource NameTemplate}"/>
                            <Border Height="17"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Balken: Mausrad scrollt senkrecht, Umschalt+Mausrad waagerecht, Strg+Mausrad zoomt -->
                    <ScrollViewer x:Name="MainScroll"
                                  Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Visible"
                                  ScrollChanged="MainScroll_ScrollChanged"
                                  PreviewMouseWheel="MainScroll_PreviewMouseWheel">
                        <Grid Width="{Binding Width}" Height="{Binding BodyHeight}">
                            <!-- Senkrechte Linien je Jahresmarke -->
                            <ItemsControl ItemsSource="{Binding Ticks}"
                                          ItemContainerStyle="{StaticResource LeftContainerStyle}"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1"
                                                   Height="{Binding DataContext.BodyHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Fill="{DynamicResource LineBrush}"
                                                   Opacity="0.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TimelineRowTemplate}"/>

                            <!-- Heute -->
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Canvas.Left="{Binding TodayLeft}"
                                           Width="2"
                                           Height="{Binding BodyHeight}"
                                           Fill="{DynamicResource AccentBrush}"
                                           ToolTip="Heute"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
