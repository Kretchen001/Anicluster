<UserControl x:Class="Anicluster.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TimelineViewModel}"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="780"
             d:DesignWidth="1250">
    <UserControl.Resources>
        <!-- Position eines Elements auf einer Canvas-Zeichenfläche (Balken, Pausen, Jahresmarken) -->
        <Style x:Key="LeftContainerStyle" TargetType="ContentPresenter">
            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
        </Style>

        <!-- Balken: Farbe nach Tier, bei „Nach Status“ nach dem Status des Animes -->
        <DataTemplate x:Key="BarTemplate" DataType="{x:Type vm:TimelineBarViewModel}">
            <!-- Die äußere Fläche ist so hoch wie die Zeile und mindestens 14 Pixel breit, damit auch kurze Zeiträume
                 (Filme, offene Enden) gut mit der Maus zu treffen sind. -->
            <Border Width="{Binding Width}"
                    MinWidth="14"
                    Height="32"
                    Background="Transparent"
                    ToolTipService.InitialShowDelay="150"
                    ToolTipService.ShowDuration="20000"
                    ToolTip="{Binding Tooltip}">
                <Border Height="18"
                        CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding Tier, Converter={StaticResource TierBrushConverter}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColorByTier}" Value="False">
                                    <Setter Property="Background" Value="{Binding State, Converter={StaticResource StateBrushConverter}}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Border>
        </DataTemplate>

        <!-- Pause: überdeckt den Balken mit der Kartenfarbe -->
        <DataTemplate x:Key="GapTemplate">
            <Border Width="{Binding Width}"
                    Height="18"
                    Margin="0,7,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    Opacity="0.85"
                    ToolTipService.InitialShowDelay="150"
                    ToolTipService.ShowDuration="20000"
                    ToolTip="{Binding Tooltip}"/>
        </DataTemplate>

        <!-- Zeile des Zeitstrahls, Doppelklick öffnet den Anime -->
        <DataTemplate x:Key="TimelineRowTemplate" DataType="{x:Type vm:TimelineRowViewModel}">
            <Border Height="32"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <ItemsControl ItemsSource="{Binding Bars}"
                                  ItemTemplate="{StaticResource BarTemplate}"
                                  ItemContainerStyle="{StaticResource LeftContainerStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Gaps}"
                                  ItemTemplate="{StaticResource GapTemplate}"
                                  ItemContainerStyle="{StaticResource LeftContainerStyle}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Name links neben dem Zeitstrahl -->
        <DataTemplate x:Key="NameTemplate" DataType="{x:Type vm:TimelineRowViewModel}">
            <Border Height="32"
                    Padding="14,0,10,0"
                    ToolTip="Doppelklick öffnet den Anime"
                    MouseLeftButtonDown="Row_MouseLeftButtonDown">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titel und Zoom -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Zeitstrahl" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{Binding InfoText}"
                           Style="{StaticResource MutedText}"
                           VerticalAlignment="Bottom"
                           Margin="14,0,0,5"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="Zoom" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Slider Width="160"
                        VerticalAlignment="Center"
                        Minimum="20" Maximum="400"
                        Value="{Binding PixelsPerYear}"
                        ToolTip="Breite eines Jahres (auch Strg + Mausrad)"/>
            </StackPanel>
        </Grid>

        <!-- Filter und Farbe -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
            <Grid Width="260" Margin="0,0,12,0">
                <TextBox x:Name="NameSearchBox"
                         VerticalAlignment="Center"
                         ToolTip="Nach Namen filtern"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Nach Name filtern …"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=NameSearchBox, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </Grid>
                <Button x:Name="TagFilterButton"
                        Content="{Binding TagButtonText}"
                        Margin="0,0,16,0"
                        Padding="14,6"
                        VerticalAlignment="Center"
                        ToolTip="Nach Tags filtern"
                        Click="BtnTagFilter_Click"/>
                <Popup x:Name="TagFilterPopup"
                       PlacementTarget="{Binding ElementName=TagFilterButton}"
                       Placement="Bottom"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       Closed="TagFilterPopup_Closed">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,4,12,12"
                            Width="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBox x:Name="TagSearchBox"
                                         Text="{Binding TagSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Tags filtern …"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=TagSearchBox, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1"
                                          Margin="0,8,0,8"
                                          MaxHeight="300"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding FilteredTags}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Tag.Designation}"
                                                      IsChecked="{Binding IsSelected}"
                                                      Margin="2,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <Button Grid.Row="2"
                                    Content="Alle abwählen"
                                    HorizontalAlignment="Right"
                                    Click="BtnClearTags_Click"/>
                        </Grid>
                    </Border>
                </Popup>
                <ToggleButton Content="Farbe: Tier"
                              Style="{StaticResource ChipStyle}"
                              Margin="0,0,8,0"
                              IsChecked="{Binding ColorByTier}"/>
                <ToggleButton Content="Farbe: Status"
                              Style="{StaticResource ChipStyle}"
                              Margin="0,0,0,0"
                              IsChecked="{Binding ColorByState}"/>
        </StackPanel>

        <!-- Aktiver Tag-Filter -->
        <Border Grid.Row="2"
                Background="{DynamicResource AccentSoftBrush}"
                CornerRadius="12"
                Padding="14,10,14,2"
                Margin="0,14,0,0"
                Visibility="{Binding HasTagFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
            <WrapPanel>
                <TextBlock Text="Tag-Filter:"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,10,8"/>
                <ItemsControl ItemsSource="{Binding SelectedTags}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource SurfaceBrush}"
                                    CornerRadius="14"
                                    Padding="12,2,2,2"
                                    Margin="0,0,6,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            Style="{StaticResource GhostButton}"
                                            Padding="7,3"
                                            FontSize="11"
                                            ToolTip="Tag aus dem Filter entfernen"
                                            Click="BtnRemoveTag_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal"
                            Margin="8,0,0,0"
                            Visibility="{Binding HasMultipleTagFilters, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 Content="Alle Tags"
                                 Margin="0,0,6,8"
                                 IsChecked="{Binding TagMatchMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TagMatchMode.All}}"/>
                    <RadioButton Style="{StaticResource ChipStyle}"
                                 Content="Ein Tag genügt"
                                 Margin="0,0,6,8"
                                 IsChecked="{Binding TagMatchMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:TagMatchMode.Any}}"/>
                </StackPanel>
                <Button Content="Zurücksetzen"
                        Style="{StaticResource GhostButton}"
                        Margin="4,0,0,8"
                        Click="BtnClearTags_Click"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,14,0,0" ClipToBounds="True">
            <Grid>
                <!-- Hinweis, wenn nichts angezeigt werden kann -->
                <TextBlock Text="{Binding EmptyText}"
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="24"
                           VerticalAlignment="Top"
                           Visibility="{Binding HasNoRows, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Kopfzeile, Namen und Zeitachse laufen synchron: Der Hauptbereich scrollt in beide Richtungen,
                     Jahresleiste und Namen folgen ihm (siehe Code-Behind). Beide Scrollbalken sind immer sichtbar. -->
                <Grid Visibility="{Binding HasRows, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"/>

                    <!-- Jahresleiste; rechts bleibt Platz für den senkrechten Scrollbalken des Hauptbereichs -->
                    <ScrollViewer x:Name="HeaderScroll"
                                  Grid.Row="0" Grid.Column="1"
                                  Margin="0,0,17,0"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <Border Width="{Binding Width}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                            <ItemsControl ItemsSource="{Binding Ticks}" ItemContainerStyle="{StaticResource LeftContainerStyle}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   Margin="6,6,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </ScrollViewer>

                    <!-- Namen; unten bleibt Platz für den waagerechten Scrollbalken des Hauptbereichs -->
                    <ScrollViewer x:Name="NamesScroll"
                                  Grid.Row="1" Grid.Column="0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Hidden"
                                  PreviewMouseWheel="NamesScroll_PreviewMouseWheel">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource NameTemplate}"/>
                            <Border Height="17"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Balken: Mausrad scrollt senkrecht, Umschalt+Mausrad waagerecht, Strg+Mausrad zoomt -->
                    <ScrollViewer x:Name="MainScroll"
                                  Grid.Row="1" Grid.Column="1"
                                  HorizontalScrollBarVisibility="Visible"
                                  VerticalScrollBarVisibility="Visible"
                                  ScrollChanged="MainScroll_ScrollChanged"
                                  PreviewMouseWheel="MainScroll_PreviewMouseWheel">
                        <Grid Width="{Binding Width}"
                              Height="{Binding BodyHeight}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <!-- Senkrechte Linien je Jahresmarke -->
                            <ItemsControl ItemsSource="{Binding Ticks}"
                                          ItemContainerStyle="{StaticResource LeftContainerStyle}"
                                          IsHitTestVisible="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Rectangle Width="1"
                                                   Height="{Binding DataContext.BodyHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Fill="{DynamicResource LineBrush}"
                                                   Opacity="0.5"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource TimelineRowTemplate}"/>

                            <!-- Heute -->
                            <Canvas IsHitTestVisible="False">
                                <Rectangle Canvas.Left="{Binding TodayLeft}"
                                           Width="2"
                                           Height="{Binding BodyHeight}"
                                           Fill="{DynamicResource AccentBrush}"
                                           ToolTip="Heute"/>
                            </Canvas>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
