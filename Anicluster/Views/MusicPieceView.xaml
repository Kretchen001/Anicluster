<UserControl x:Class="Anicluster.Views.MusicPieceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:Anicluster.Views"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MusicPieceViewModel}"
             d:DesignHeight="155"
             d:DesignWidth="250">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Eintrag entfernen"
                      Click="BtnRemoveEntry_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border Style="{StaticResource RoundedBorder}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Margin="0,0,0,6">Name:</TextBlock>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding Name}"
                             FontSize="16"
                             FontWeight="Bold"
                             Margin="0,0,0,5"/>
                    <Button Grid.Column="1"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,-2,-5,0"
                            Template="{StaticResource buttonCrossTemplate}"
                            Click="BtnRemoveEntry_Click"/>
                </Grid>
            </Grid>
            <views:ScoreBarView DataContext="{Binding Score}"
                                Margin="0,0,0,2"/>
            <Grid>
                <TextBox x:Name="TbComment"
                         Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         ToolTip="Kommentarfeld"/>
                <TextBlock Text="Kommentar hier eingeben..."
                           Foreground="LightGray"
                           Margin="5,3,0,0"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           Visibility="{Binding Text, ElementName=TbComment, Converter={StaticResource EmptyToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
