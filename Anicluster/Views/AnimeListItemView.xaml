<UserControl x:Class="Anicluster.Views.AnimeListItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnimeListItemViewModel}"
             d:DesignHeight="64"
             d:DesignWidth="900">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Details anzeigen" Click="MenuItemDetailsAndEdit_Click"/>
            <MenuItem Header="Löschen" Click="MenuItemDelete_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <!-- Karte mit Tier-Farbleiste links, Doppelklick öffnet den Anime -->
    <Border Style="{StaticResource ItemCard}"
            Margin="0,0,0,10"
            MouseLeftButtonDown="Card_MouseLeftButtonDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}"
                    CornerRadius="12,0,0,12"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding Name}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Margin="20,16,12,16"/>

            <!-- Tier -->
            <Border Grid.Column="2"
                    Width="34" Height="26"
                    CornerRadius="7"
                    VerticalAlignment="Center"
                    Margin="8,0"
                    Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}">
                <TextBlock Text="{Binding TierText}"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{Binding Tier, Converter={StaticResource TierBrushConverter}, ConverterParameter=Text}"/>
            </Border>

            <!-- Status -->
            <Grid Grid.Column="3" VerticalAlignment="Center" Margin="8,0" MinWidth="110">
                <Border Background="{Binding State, Converter={StaticResource StateBrushConverter}}"
                        Opacity="0.2"
                        CornerRadius="11"/>
                <TextBlock Text="{Binding StateText}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="12,4"
                           Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}"/>
            </Grid>

            <!-- Favorit -->
            <Viewbox Grid.Column="4" Width="22" Height="22" Margin="12,0,20,0">
                <Canvas Width="50" Height="50">
                    <Path Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Fill" Value="{DynamicResource LineBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Fill" Value="#F5B301"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Canvas>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
