<UserControl x:Class="Anicluster.Views.AnimeListItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnimeListItemViewModel}"
             d:DesignHeight="60"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <!-- Hintergrundfarbe der Karte je nach Tier -->
        <Style TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tier}" Value="NotDefined">
                    <Setter Property="Background" Value="WhiteSmoke"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="S">
                    <Setter Property="Background" Value="DeepSkyBlue"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="A">
                    <Setter Property="Background" Value="#FF00BD00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="B">
                    <Setter Property="Background" Value="Yellow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="C">
                    <Setter Property="Background" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="D">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tier}" Value="E">
                    <Setter Property="Background" Value="DarkRed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Details anzeigen"
                      Click="MenuItemDetailsAndEdit_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="20"
            Margin="0,0,0,5">
        <StackPanel Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Margin="5,0,0,0"/>
                <TextBlock Text="{Binding StateText}"
                           VerticalAlignment="Center"
                           Grid.Column="1"/>
                <Viewbox VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Margin="10"
                         Height="25"
                         Grid.Column="2">
                    <Canvas Height="50"
                            Width="50">
                        <Path Stretch="Uniform"
                              Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="#FFAFAFAF"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Fill" Value="Gold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Canvas>
                </Viewbox>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
