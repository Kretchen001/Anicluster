<UserControl x:Class="Anicluster.Views.AnimeTileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Modells.Anime;assembly=Modells"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AnimeListItemViewModel}"
             d:DesignHeight="310"
             d:DesignWidth="170">
    <UserControl.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Details anzeigen" Click="MenuItemDetailsAndEdit_Click"/>
            <MenuItem Header="Löschen" Click="MenuItemDelete_Click"/>
        </ContextMenu>
    </UserControl.ContextMenu>
    <!-- Kachel mit Cover, Tier und Favorit auf dem Bild, darunter Name und Status. Doppelklick öffnet den Anime -->
    <Border Style="{StaticResource ItemCard}"
            Width="176"
            Margin="0,0,14,14"
            ToolTip="{Binding Name}"
            MouseLeftButtonDown="Tile_MouseLeftButtonDown">
        <StackPanel Margin="7">
            <!-- Bildbereich im Seitenverhältnis 2:3, die abgerundeten Ecken entstehen über die Clip-Geometrie -->
            <Grid Width="160"
                  Height="240"
                  Background="{DynamicResource SurfaceAltBrush}">
                <Grid.Clip>
                    <RectangleGeometry Rect="0,0,160,240" RadiusX="9" RadiusY="9"/>
                </Grid.Clip>

                <!-- Platzhalter, solange kein Bild vorhanden ist -->
                <TextBlock Text="&#xE91B;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="40"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasImage}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Image Source="{Binding Thumbnail, Converter={StaticResource BytesToImageConverter}}"
                       Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- Tier oben links, nur wenn gesetzt -->
                <Border Width="34"
                        Height="26"
                        CornerRadius="7"
                        Margin="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{Binding Tier, Converter={StaticResource TierBrushConverter}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tier}" Value="{x:Static models:Tier.NotDefined}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TierText}"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{Binding Tier, Converter={StaticResource TierBrushConverter}, ConverterParameter=Text}"/>
                </Border>

                <!-- Favorit oben rechts, auf einer Scheibe in Flächenfarbe, damit der Stern auf jedem Bild erkennbar bleibt -->
                <Grid Width="30"
                      Height="30"
                      Margin="8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Ellipse Fill="{DynamicResource SurfaceBrush}" Opacity="0.9"/>
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="50" Height="50">
                            <Path Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z"
                                  Fill="#F5B301"/>
                        </Canvas>
                    </Viewbox>
                </Grid>
            </Grid>

            <TextBlock Text="{Binding Name}"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Margin="3,10,3,0"/>
            <StackPanel Orientation="Horizontal" Margin="3,4,3,2">
                <Ellipse Width="8"
                         Height="8"
                         Margin="0,0,6,0"
                         VerticalAlignment="Center"
                         Fill="{Binding State, Converter={StaticResource StateBrushConverter}}"/>
                <TextBlock Text="{Binding StateText}"
                           Style="{StaticResource MutedText}"
                           FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
