<UserControl x:Class="Anicluster.Views.TagManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TagManagerViewModel}"
             MinWidth="800"
             MinHeight="450"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="↳"
                      Background="Beige">
                <MenuItem Header="Export List"/>
                <MenuItem Header="Import List"/>
            </MenuItem>
            <MenuItem Header="Tag hinzufügen"
                      Click="MenuItemAddTag_Click"/>
            <MenuItem Header="Ausgewählten Tag Löschen (einer!)"
                      Click="MenuItemDeleteSelectedTag_Click"/>
            <MenuItem Header="{Binding SearchToggleText}"
                      Click="MenuItemTagSearch_Click"/>
        </Menu>
        <Grid Margin="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontSize="12">
                    Suche:
                </Label>
                <TextBox Margin="10,0,10,0"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="14"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Grid.Column="2"
                        Padding="2,3"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        Click="BtnClearSearch_Click">
                    Suche leeren
                </Button>
            </Grid>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding FilteredTags}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      Margin="0,0,0,5"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id"
                                        IsReadOnly="True"
                                        Binding="{Binding Id}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Tag"
                                        IsReadOnly="True"
                                        Binding="{Binding Designation}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <!-- Eingabe eines neuen Tags: rot, wenn es den Namen schon gibt -->
        <Popup IsOpen="{Binding IsAddTagPopupOpen, Mode=TwoWay}"
               Placement="Mouse"
               StaysOpen="False">
            <Border BorderBrush="Black"
                    BorderThickness="1"
                    Background="White"
                    Padding="10">
                <StackPanel>
                    <TextBox Width="200"
                             Margin="0,0,0,10"
                             Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Background" Value="LightGreen"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNewTagNameDuplicate}" Value="True">
                                        <Setter Property="Background" Value="IndianRed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Button Content="OK"
                            Click="BtnPopUp_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</UserControl>
