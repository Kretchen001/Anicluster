<UserControl x:Class="Anicluster.Views.QuickAnimeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Modells.Anime;assembly=Modells"
             xmlns:vm="clr-namespace:Anicluster.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:QuickAnimeViewModel}"
             MinWidth="800"
             MinHeight="450"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Stern zum Favorisieren: grau, bei Favorit gelb -->
        <Style x:Key="FavoriteStarStyle" TargetType="Path">
            <Setter Property="Fill" Value="#FFAFAFAF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Fill" Value="Yellow"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border CornerRadius="0"
                Grid.Row="0"
                Background="LightBlue">
            <Grid>
                <Label x:Name="LbName"
                       Content="{Binding Name}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="25,0,0,0"
                       Height="40"
                       MinWidth="300"
                       FontWeight="Bold"
                       VerticalContentAlignment="Center"
                       MouseLeftButtonDown="LbName_MouseLeftButtonDown"
                       FontSize="20"
                       Background="Transparent"/>
                <TextBox x:Name="TBName"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Margin="25,0,0,0"
                         Height="40"
                         MinWidth="300"
                         VerticalContentAlignment="Center"
                         KeyDown="TBName_KeyDown"
                         FontSize="20"
                         LostFocus="TBName_LostFocus"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="Black"/>
                <Viewbox VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Margin="10,10,25,10"
                         Height="75"
                         ToolTip="Favorisieren?">
                    <Canvas Height="50"
                            Width="50">
                        <Path Style="{StaticResource FavoriteStarStyle}"
                              Stretch="Uniform"
                              Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z"
                              MouseDown="StarPath_MouseDown"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
        <GroupBox Header="Bewertung"
                  FontSize="14"
                  Padding="5"
                  Margin="0,10,0,0"
                  Grid.Row="1">
            <!-- Tier-Auswahl: das Tier steht im Tag des Buttons, der gewählte Button erhält einen schwarzen Rahmen -->
            <UniformGrid Columns="6"
                         Height="50">
                <Button Style="{StaticResource RoundedButton}"
                        Background="DeepSkyBlue"
                        Foreground="Black"
                        Content="S"
                        Tag="{x:Static models:Tier.S}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.S}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
                <Button Style="{StaticResource RoundedButton}"
                        Background="#FF00BD00"
                        Foreground="Black"
                        Content="A"
                        Tag="{x:Static models:Tier.A}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.A}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
                <Button Style="{StaticResource RoundedButton}"
                        Background="Yellow"
                        Foreground="Black"
                        Content="B"
                        Tag="{x:Static models:Tier.B}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.B}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
                <Button Style="{StaticResource RoundedButton}"
                        Background="Orange"
                        Foreground="Black"
                        Content="C"
                        Tag="{x:Static models:Tier.C}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.C}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
                <Button Style="{StaticResource RoundedButton}"
                        Background="Red"
                        Content="D"
                        Tag="{x:Static models:Tier.D}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.D}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
                <Button Style="{StaticResource RoundedButton}"
                        Background="DarkRed"
                        Content="E"
                        Tag="{x:Static models:Tier.E}"
                        BorderBrush="{Binding Tier, Converter={StaticResource TierSelectedConverter}, ConverterParameter={x:Static models:Tier.E}}"
                        BorderThickness="3"
                        Click="BtnTier_Click"/>
            </UniformGrid>
        </GroupBox>
        <Button Grid.Row="2"
                Margin="25,5,25,5"
                Height="50"
                Background="#FF86DE83"
                FontSize="14"
                Style="{StaticResource RoundedGreenButton}"
                Content="Hinzufügen"
                Click="BtnAdd_Click"/>
    </Grid>
</UserControl>
