<Window x:Class="Anicluster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem x:Name="MenuItemNewAnime" Header="Neuer Anime" Click="MenuItemNewAnime_Click"/>
            <MenuItem Header="Tags"/>
        </Menu>
        <Grid>
            <Button Content="Staffelgenerator aufrufen (Test)" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Button_Click"/>
            <Button Content="Bewertung aufrufen (Test)" HorizontalAlignment="Center" Margin="0,239,0,0" VerticalAlignment="Top" Click="Button_Click_1"/>
        </Grid>
    </DockPanel>
</Window>
