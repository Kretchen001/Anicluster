<Window x:Class="Anicluster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Anicluster.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Style="{StaticResource AppWindowStyle}"
        Title="{Binding AppTitle}"
        Width="1320"
        Height="820"
        MinWidth="1000"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="ApplicationCommands.New"/>
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <Border Grid.Column="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Resources/Icon/Anicluster-64.png"
                               Width="32"
                               Height="32"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Anicluster"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Deine Anime-Sammlung"
                               Style="{StaticResource MutedText}"
                               Margin="0,2,0,24"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="+  Neuer Anime"
                            ToolTip="Strg + N"
                            Click="BtnNewAnime_Click"/>
                    <Button Content="Schnell hinzufügen"
                            Margin="0,8,0,0"
                            Click="BtnQuickAnime_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,30,0,0">
                    <RadioButton Style="{StaticResource NavStyle}"
                                 IsChecked="{Binding Navigation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:NavigationTarget.Library}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Bibliothek" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavStyle}"
                                 IsChecked="{Binding Navigation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:NavigationTarget.Tags}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8EC;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Tags" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavStyle}"
                                 IsChecked="{Binding Navigation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:NavigationTarget.TagNetwork}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Tag-Netzwerk" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavStyle}"
                                 IsChecked="{Binding Navigation, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static vm:NavigationTarget.Settings}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" Width="28" VerticalAlignment="Center"/>
                            <TextBlock Text="Einstellungen" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBlock Grid.Row="2"
                           Text="{Binding VersionText}"
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           Background="Transparent"
                           MouseRightButtonUp="VersionText_MouseRightButtonUp"/>
            </Grid>
        </Border>

        <!-- Aktuelle Seite (Bibliothek, Editor, Tags oder Einstellungen) -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentPage}"/>
    </Grid>
</Window>
