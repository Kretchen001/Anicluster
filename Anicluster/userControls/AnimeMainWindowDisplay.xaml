<UserControl x:Class="Anicluster.userControls.AnimeMainWindowDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Anicluster.userControls"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="NotDefined">
                    <Setter Property="Background"
                            Value="WhiteSmoke"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="S">
                    <Setter Property="Background"
                            Value="DeepSkyBlue"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="A">
                    <Setter Property="Background"
                            Value="#FF00BD00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="B">
                    <Setter Property="Background"
                            Value="Yellow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="C">
                    <Setter Property="Background"
                            Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="D">
                    <Setter Property="Background"
                            Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="E">
                    <Setter Property="Background"
                            Value="DarkRed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Gray"
            BorderThickness="1"
            CornerRadius="20">
        <StackPanel Margin="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Path=Anime.Name}"
                           VerticalAlignment="Center"
                           Grid.Column="0"
                           Margin="5,0,0,0"/>
                <TextBlock Text="{Binding Path=TranslationOfState}"
                           VerticalAlignment="Center"
                           Grid.Column="1"/>
                <Viewbox VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Margin="10"
                         ToolTip="Favorisieren?"
                         Height="25"
                         Grid.Column="2">
                    <Canvas Height="50"
                            Width="50">                            
                        <Path x:Name="StarPath"
                              Fill="#FFAFAFAF"
                              Stretch="Uniform"
                              Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
