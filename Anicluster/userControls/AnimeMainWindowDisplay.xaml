<UserControl x:Class="Anicluster.userControls.AnimeMainWindowDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Anicluster.userControls"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="NotDefined">
                    <Setter Property="Background" Value="WhiteSmoke" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="S">
                    <Setter Property="Background" Value="DeepSkyBlue"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="A">
                    <Setter Property="Background" Value="#FF00BD00"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="B">
                    <Setter Property="Background" Value="Yellow"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="C">
                    <Setter Property="Background" Value="Orange"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="D">
                    <Setter Property="Background" Value="Red"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Anime.Tier, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="E">
                    <Setter Property="Background" Value="DarkRed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="20">
        <StackPanel Margin="20">
            
        </StackPanel>
    </Border>
</UserControl>
