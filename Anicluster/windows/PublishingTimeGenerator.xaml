<Window x:Class="Anicluster.windows.PublishingTimeGenerator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Veröffentlichungszeitraum"
        Height="350"
        Width="600"
        ResizeMode="NoResize"
        Closed="Window_Closed">
    <StackPanel Margin="5">
        <GroupBox Header="Produktionsdaten">
            <UniformGrid>
                <TextBlock x:Name="TxtBlockStartDatum"
                           Text="Startdatum"
                           VerticalAlignment="Center"/>
                <DatePicker x:Name="DateTimePickerStart"
                            Text="Start"
                            Margin="0,0,0,2"
                            FirstDayOfWeek="Monday"
                            SelectedDateChanged="DateTimePickerStart_SelectedDateChanged"/>
                <TextBlock x:Name="TxtBlockEndDatum"
                           Text="Enddatum"
                           VerticalAlignment="Center"/>
                <DatePicker x:Name="DateTimePickerEnd"
                            Text="Ende"
                            FirstDayOfWeek="Monday"
                            SelectedDateChanged="DateTimePickerEnd_SelectedDateChanged"/>
            </UniformGrid>
        </GroupBox>
        <GroupBox Header="Unterbrechungen"
                  Height="225">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <UniformGrid Grid.Row="0" Columns="2">
                    <TextBlock x:Name="TxtBlockNewInterruptionStartDatum"
                               Text="Startdatum"
                               VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateTimePickerNewInterruptionStart"
                                Text="Start"
                                Margin="0,0,0,2"
                                FirstDayOfWeek="Monday"/>
                    <TextBlock x:Name="TxtBlockNewInterruptionEndDatum"
                               Text="Enddatum"
                               VerticalAlignment="Center"/>
                    <DatePicker x:Name="DateTimePickerNewInterruptionEnd"
                                Text="Ende"
                                FirstDayOfWeek="Monday"/>
                </UniformGrid>
                <Button x:Name="BtnAddInterruption"
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="5"
                        Click="BtnAddInterruption_Click">
                    Hinzufügen
                </Button>
                <DataGrid x:Name="DgInterruptions"
                          Grid.Row="2"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          AutoGenerateColumns="False"
                          SelectionMode="Single"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Startdatum" 
                                            Binding="{Binding Start}" 
                                            Width="auto" />
                        <DataGridTextColumn Header="Enddatum" 
                                            Binding="{Binding End}" 
                                            Width="auto" />
                        <DataGridTextColumn Header="Kommentar" 
                                            Binding="{Binding Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </StackPanel>
</Window>
