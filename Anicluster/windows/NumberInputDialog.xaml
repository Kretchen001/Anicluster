<Window x:Class="Anicluster.windows.NumberInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        Title="Zahleneingabe" Height="120" Width="300">
    <Grid>
        <Label HorizontalAlignment="Center" >
            Bitte eine gültige Zahl unter 100 eingeben!
        </Label>
        <TextBox Name="InputTextBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25" Width="100" Height="20" KeyDown="InputTextBox_KeyDown" />
        <Button Content="OK" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Padding="10,0,10,0" Click="OkButton_Click"/>
    </Grid>
</Window>
