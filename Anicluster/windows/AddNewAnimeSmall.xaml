<Window x:Class="Anicluster.windows.AddNewAnimeSmall"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        Title="AddNewAnimeSmall"
        Height="450"
        Width="800">
    <Window.Resources>
        <Style x:Key="RoundedButton"
           TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TierButton"
                            Background="{TemplateBinding Background}"
                            CornerRadius="15"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground"
                Value="White"/>
            <Setter Property="Width"
                Value="75"/>
            <Setter Property="Margin"
                Value="3,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border CornerRadius="0"
                Grid.Row="0"
                Background="LightBlue">
            <Grid>
                <Label x:Name="LbName"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="25,0,0,0"
                       Height="40"
                       FontWeight="Bold"
                       VerticalContentAlignment="Center"
                       MouseLeftButtonDown="LbName_MouseLeftButtonDown"
                       FontSize="20"
                       Background="Transparent" />
                <TextBox x:Name="TBName"
                         Visibility="Collapsed"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         Margin="25,0,0,0"
                         Height="40"
                         VerticalContentAlignment="Center"
                         KeyDown="TBName_KeyDown"
                         FontSize="20"
                         LostFocus="TBName_LostFocus"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="Black"/>
                <Viewbox VerticalAlignment="Center"
                         HorizontalAlignment="Right"
                         Margin="10,10,25,10"
                         Height="75"
                         ToolTip="Favorisieren?">
                    <Canvas Height="50"
                            Width="50">
                        <Path x:Name="StarPath"
                              Fill="#FFAFAFAF"
                              Stretch="Uniform"
                              Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z"
                              MouseDown="StarPath_MouseDown"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
        <GroupBox Header="Bewertung"
                  FontSize="14"
                  Padding="5"
                  Margin="0,10,0,0"
                  Grid.Row="1">
            <UniformGrid Columns="6"
                         Height="50">
                <Button x:Name="BtnTierS"
                        Style="{StaticResource RoundedButton}"
                        Background="DeepSkyBlue"
                        Foreground="Black"
                        Content="S"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierS_Click"/>
                <Button x:Name="BtnTierA"
                        Style="{StaticResource RoundedButton}"
                        Background="#FF00BD00"
                        Foreground="Black"
                        Content="A"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierA_Click"/>
                <Button x:Name="BtnTierB"
                        Style="{StaticResource RoundedButton}"
                        Background="Yellow"
                        Foreground="Black"
                        Content="B"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierB_Click"/>
                <Button x:Name="BtnTierC"
                        Style="{StaticResource RoundedButton}"
                        Background="Orange"
                        Foreground="Black"
                        Content="C"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierC_Click"/>
                <Button x:Name="BtnTierD"
                        Style="{StaticResource RoundedButton}"
                        Background="Red"
                        Content="D"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierD_Click"/>
                <Button x:Name="BtnTierE"
                        Style="{StaticResource RoundedButton}"
                        Background="DarkRed"
                        Content="E"
                        BorderBrush="Black"
                        BorderThickness="0.5"
                        Click="BtnTierE_Click"/>
            </UniformGrid>
        </GroupBox>
        <Button x:Name="BtnAddAnimeAsNew"
                Grid.Row="2"
                Margin="25,5,25,5"
                Height="50"
                Background="#FF86DE83"
                FontSize="14"
                Click="BtnAddAnimeAsNew_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background"
                            Value="#FF4CAF50"/>
                    <Setter Property="Foreground"
                            Value="Black"/>
                    <Setter Property="BorderBrush"
                            Value="#FF388E3C"/>
                    <Setter Property="BorderThickness"
                            Value="1"/>
                </Style>
            </Button.Style>
            Hinzufügen
        </Button>
    </Grid>
</Window>
