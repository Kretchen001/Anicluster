<Window x:Class="Anicluster.windows.ShowDetailsTags"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        Title="Ausgewählte Tags" Height="450" Width="800">
    <Grid Margin="3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="14*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <DataGrid Name="dataGridTagList" AutoGenerateColumns="False" Grid.Row="0" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="dataGridTextId" Header="Nr." IsReadOnly="True" Binding="{Binding number}" Width="4*"/>
                <DataGridTextColumn Header="Name" IsReadOnly="True" Binding="{Binding tagDesignator}" Width="30*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="1" Click="clickConfirmTagChoice" >Ok</Button>
    </Grid>
</Window>
