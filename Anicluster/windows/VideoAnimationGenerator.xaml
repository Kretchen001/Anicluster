<Window x:Class="Anicluster.windows.VideoAnimationGenerator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        Title="OVA / Movie Generator"
        Height="350"
        Width="700"
        ResizeMode="NoResize">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- LISTE -->
        <ListView x:Name="ListViewVideos"
                  Margin="10"
                  Grid.Column="0"
                  KeyDown="ListViewVideos_KeyDown"
                  AllowDrop="True"
                  Drop="ListViewVideos_Drop"
                  DragOver="ListViewVideos_DragOver"
                  PreviewMouseLeftButtonDown="ListViewVideos_PreviewMouseLeftButtonDown">

            <ListView.View>
                <GridView>

                    <GridViewColumn Header="Nr." Width="40">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Id}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Typ" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding VideoType}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Kommentar" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Comment}" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <!-- RECHTE SEITE -->
        <Label Content="Typ"
               Margin="5,15,0,0"
               FontWeight="Bold"
               Grid.Column="1"
               VerticalAlignment="Top"/>

        <ComboBox x:Name="ComboBoxType"
                  Margin="10,40,10,0"
                  Grid.Column="1"
                  Height="25"
                  VerticalAlignment="Top"/>

        <Label Content="Kommentar"
               Margin="5,75,0,0"
               FontWeight="Bold"
               Grid.Column="1"
               VerticalAlignment="Top"/>

        <TextBox x:Name="TextBoxKommentar"
                 Margin="10,100,10,50"
                 Grid.Column="1"
                 TextWrapping="Wrap"/>

        <Button x:Name="btnHinzufuegen"
                Content="Hinzufügen"
                Margin="55,0,55,10"
                Grid.Column="1"
                Height="25"
                VerticalAlignment="Bottom"
                Click="BtnHinzufuegen_Click"/>
    </Grid>
</Window>