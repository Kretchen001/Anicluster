<Window x:Class="Anicluster.windows.RatingGenerator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        xmlns:uc="clr-namespace:Anicluster.userControls"
        xmlns:wf="clr-namespace:WpfMath.Controls;assembly=WpfMath"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="Bewertung"
        Height="350"
        Width="600"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem x:Name="MenuItemAceptRating"
                      Header="Bewertung übernehmen"
                      Click="MenuItemAceptRating_Click" />
            <MenuItem x:Name="MenuItemHelp"
                      Header="?"
                      Click="MenuItemHelp_Click" />
        </Menu>
        <Popup x:Name="PopUpHelp" 
               Placement="Mouse"  
               MouseLeave="PopUpHelp_MouseLeave">
            <TextBox>
                Einträge lassen sich per Kontextmenü (Rechtsklick) wieder entfernen.
            </TextBox>
        </Popup>
        <TabControl SelectionChanged="TabControl_SelectionChanged"
                    Grid.Row="1">
            <TabItem x:Name="TabItemAuswertung" Header="Auswertung">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Berechnung" Grid.Column="0" FontWeight="DemiBold"
                               Margin="5" Height="auto" VerticalAlignment="Top" HorizontalAlignment="Left" Width="auto"/>
                    <wf:FormulaControl Scale="14" Grid.Column="1" Margin="10,5,5,5" Formula="\frac{Ge \cdot 40 + An \cdot 25 + SE \cdot 10 + A.G \cdot 25}{100}" Height="auto"/>
                    <TextBlock Text="Aktuelle Eingabe" Grid.Column="0" FontWeight="DemiBold"
                               Margin="5,40,0,0" Height="auto" VerticalAlignment="Top" HorizontalAlignment="Left" Width="auto"/>
                    <wf:FormulaControl x:Name="FormulaInsert" Scale="14" Grid.Column="1" Margin="10,40,5,5" Formula="\frac{Story \cdot 40 + Animation \cdot 25 + SpecialEffects \cdot 10 + Acoustic.General \cdot 25}{100} = General" Height="auto"/>
                </Grid>
            </TabItem>
            <TabItem Header="Bereiche">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Label Height="30"
                               VerticalContentAlignment="Center">
                            Geschichte
                        </Label>
                        <Label Height="30"
                               VerticalContentAlignment="Center">
                            Animation
                        </Label>
                        <Label Height="30"
                               VerticalContentAlignment="Center">
                            Spezialeffekte
                        </Label>
                        <Label Height="30"
                               VerticalContentAlignment="Center">
                            Soundtrack
                        </Label>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Grid>
                            <ProgressBar x:Name="ProgBarHistory"
                                         Maximum="100"
                                         Height="24"
                                         Value="{Binding History}"
                                         Margin="3"
                                         ToolTip="Bewertung, bitte klicken und Zahlen eingeben oder Mausrad verwenden"
                                         MouseWheel="ProgBarHistory_MouseWheel"
                                         MouseLeftButtonDown="ProgBarHistory_MouseLeftButtonDown"/>
                            <Label x:Name="LbHistory"
                                   Content="{Binding History}"
                                   Margin="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Black"
                                   Background="Transparent"/>
                        </Grid>
                        <Grid>
                            <ProgressBar x:Name="ProgBarAnimation"
                                         Height="24"
                                         Value="{Binding Animation}"
                                         Margin="3"
                                         MouseWheel="ProgBarAnimation_MouseWheel"
                                         MouseLeftButtonDown="ProgBarAnimation_MouseLeftButtonDown"/>
                            <Label x:Name="LbAnimation"
                                   Content="{Binding Animation}"
                                   Margin="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Black"
                                   Background="Transparent"/>
                        </Grid>
                        <Grid>
                            <ProgressBar x:Name="ProgBarSpecialEffects"
                                         Height="24"
                                         Value="{Binding SpecialEffects}"
                                         Margin="3"
                                         MouseWheel="ProgBarSpecialEffects_MouseWheel"
                                         MouseLeftButtonDown="ProgBarSpecialEffects_MouseLeftButtonDown"/>
                            <Label x:Name="LbSpecialEffects"
                                   Content="{Binding SpecialEffects}"
                                   Margin="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Black"
                                   Background="Transparent"/>
                        </Grid>
                        <Grid>
                            <ProgressBar x:Name="ProgBarSoundtrack"
                                         Height="24"
                                         Value="{Binding Soundtrack}"
                                         Margin="3"
                                         MouseWheel="ProgBarSoundtrack_MouseWheel"
                                         MouseLeftButtonDown="ProgBarSoundtrack_MouseLeftButtonDown"/>
                            <Label x:Name="LbSoundtrack"
                                   Content="{Binding Soundtrack}"
                                   Margin="0"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="Black"
                                   Background="Transparent">
                                <Label.Style>
                                    <Style TargetType="Label">
                                        <Setter Property="Content"
                                                Value="{Binding Soundtrack}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Soundtrack}"
                                                         Value="0">
                                                <Setter Property="Content"
                                                        Value="0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Soundtrack}"
                                                         Value="-1">
                                                <Setter Property="Content"
                                                        Value="0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Soundtrack}">
                                                <Setter Property="Content"
                                                        Value="{Binding Soundtrack}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>
                        </Grid>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Opening(s)">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0">
                        <StackPanel x:Name="StackPanelOpening"></StackPanel>
                    </ScrollViewer>
                    <Button x:Name="btnOpeningAdd"
                            Grid.Row="1"
                            Width="150"
                            Margin="5,2,5,2"
                            HorizontalAlignment="Right"
                            Click="BtnOpeningAdd_Click">
                        Opening Hinzufügen
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Header="Ending(s)">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0">
                        <StackPanel x:Name="StackPanelEnding"></StackPanel>
                    </ScrollViewer>
                    <Button x:Name="btnEndAdd"
                            Grid.Row="1"
                            Width="150"
                            Margin="5,2,5,2"
                            HorizontalAlignment="Right"
                            Click="BtnEndingAdd_Click">
                        Ending Hinzufügen
                    </Button>
                </Grid>
            </TabItem>
            <TabItem Header="Syncro(s)">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0">
                        <StackPanel x:Name="StackPanelSyncro"></StackPanel>
                    </ScrollViewer>
                    <Button x:Name="btnSyncroAdd"
                            Grid.Row="1"
                            Width="150"
                            Margin="5,2,5,2"
                            HorizontalAlignment="Right"
                            Click="BtnSyncroAdd_Click">
                        Syncronisation Hinzufügen
                    </Button>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
