<Window x:Class="Anicluster.windows.AddNewAnime"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Title="AddNewAnime" Height="750" Width="1100">
    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <!-- Hintergrund und runde Ecken -->
            <Border CornerRadius="20" Background="#FF545454" Padding="10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="20" Grid.Row="0" Background="LightBlue">
                        <Grid>
                            <Label x:Name="LbName" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0" Height="40" FontWeight="Bold" VerticalContentAlignment="Center" MinWidth="300" MouseLeftButtonDown="LbName_MouseLeftButtonDown" FontSize="18" Background="Transparent"></Label>
                            <TextBox x:Name="TBName" Visibility="Collapsed" Text="{Binding NewAnime.Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0" Height="40" VerticalContentAlignment="Center" KeyDown="EditableTextBox_KeyDown" FontSize="18"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="25,5,25,5" Background="#FF86DE83">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FF4CAF50"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderBrush" Value="#FF388E3C"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Style>
                            Hinzufügen
                        </Button>
                        <Button x:Name="BtnCancel" Grid.Column="1" Margin="25,5,25,5" Background="#FFE08F8F" Click="BtnCancel_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFAF4C4C"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderBrush" Value="#FF8E3838"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Style>
                            Abbrechen
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
