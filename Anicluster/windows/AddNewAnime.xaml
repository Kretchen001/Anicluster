<Window x:Class="Anicluster.windows.AddNewAnime"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Title="AddNewAnime" Height="750" Width="1100">
    <Border MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Grid>
            <!-- Hintergrund und runde Ecken -->
            <Border CornerRadius="20" Background="#FFAFAFAF" Padding="10">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="75"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>
                    <Border CornerRadius="20" Grid.Row="0" Background="LightBlue">
                        <Grid>
                            <Label x:Name="LbName" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0" Height="40" FontWeight="Bold" VerticalContentAlignment="Center" MinWidth="300" MouseLeftButtonDown="LbName_MouseLeftButtonDown" FontSize="20" Background="Transparent"></Label>
                            <TextBox x:Name="TBName" Visibility="Collapsed" Text="{Binding NewAnime.Name, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="25,0,0,0" Height="40" VerticalContentAlignment="Center" KeyDown="TBName_KeyDown" FontSize="20" LostFocus="TBName_LostFocus" Background="Transparent" BorderThickness="0" Foreground="Black"/>
                            <Viewbox VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="10,10,25,10" ToolTip="Favorisieren?">
                                <Canvas Height="50" Width="50">
                                    <Path x:Name="StarPath" Fill="#FFAFAFAF" Stretch="Uniform" Data="M 25,0 L 31,20 H 50 L 34,31 L 40,50 L 25,39 L 10,50 L 16,31 L 0,20 H 19 Z"  MouseDown="StarPath_MouseDown"/>
                                </Canvas>
                            </Viewbox>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="10">
                        <StackPanel>
                            <GroupBox Header="Zusätzliche Informationen" FontSize="14" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Height="30" Margin="0,0,0,5" VerticalContentAlignment="Center">Original Name</Label>
                                        <Label Height="30" VerticalContentAlignment="Center">Url (Anime-Planet z.B.)</Label>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBox Height="30" Margin="0,0,0,5"></TextBox>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Height="30" Margin="0,0,5,0"></TextBox>
                                            <Button Grid.Column="1" Padding="3,0,3,0">Auto-Generation</Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox x:Name="GrBoxStatus" Header="Zustand" FontSize="14" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="5">
                                        <RadioButton GroupName="Options" VerticalContentAlignment="Center" Content="Wunschliste" Margin="5"/>
                                        <RadioButton GroupName="Options" VerticalContentAlignment="Center" Content="Begonnen" Margin="5"/>
                                        <RadioButton GroupName="Options" VerticalContentAlignment="Center" Content="Fertig" Margin="5"/>
                                        <RadioButton GroupName="Options" VerticalContentAlignment="Center" Content="Unterbrochen" Margin="5"/>
                                        <RadioButton GroupName="Options" VerticalContentAlignment="Center" Content="Abgebrochen" Margin="5"/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Margin="7" AcceptsReturn="True" TextWrapping="Wrap" ToolTip="Kommentarfeld"/>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Bewertung" FontSize="14" Padding="5" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <ProgressBar x:Name="ProgBarGeneral" Maximum="100" Height="24" Margin="3"/>
                                            <Label x:Name="LbGeneral" Content="{Binding NewAnime.Rating.General}" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black" Background="Transparent" />
                                        </Grid>
                                        <Button Grid.Column="1" Padding="5,0,5,0" Margin="5,0,5,0">Bewerten</Button>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,5,0,0">
                                        <StackPanel Orientation="Horizontal" Height="50">
                                            <Button Width="75" Margin="3,0,5,0">S</Button>
                                            <Button Width="75" Margin="5,0,5,0">A</Button>
                                            <Button Width="75" Margin="5,0,5,0">B</Button>
                                            <Button Width="75" Margin="5,0,5,0">C</Button>
                                            <Button Width="75" Margin="5,0,5,0">D</Button>
                                            <Button Width="75" Margin="5,0,5,0">E</Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Staffeln &#38; OVAs" FontSize="14" Margin="0,10,0,0" Padding="5">

                            </GroupBox>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="25,5,25,5" Background="#FF86DE83" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FF4CAF50"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderBrush" Value="#FF388E3C"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Style>
                            Hinzufügen
                        </Button>
                        <Button x:Name="BtnCancel" Grid.Column="1" Margin="25,5,25,5" Background="#FFE08F8F" Click="BtnCancel_Click" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        CornerRadius="20">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFAF4C4C"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="BorderBrush" Value="#FF8E3838"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </Button.Style>
                            Abbrechen
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
