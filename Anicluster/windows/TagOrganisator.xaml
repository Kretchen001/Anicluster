<Window x:Class="Anicluster.windows.TagOrganisator"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Anicluster.windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="TagOrganisator"
        Height="450"
        Width="800">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="↳"
                      Background="Beige">
                <MenuItem Header="Export List"/>
                <MenuItem Header="Import List"/>
            </MenuItem>
            <MenuItem Header="Tag hinzufügen"
                      Click="MenuItemAddTag_Click"/>
            <MenuItem Header="Ausgewählten Tag Löschen (einer!)"
                      x:Name="MenuItemDeleteSelectedTag"
                      Click="MenuItemDeleteSelectedTag_Click"/>
            <MenuItem Header="Suche einblenden"
                      x:Name="MenuItemTagSearch"
                      Click="MenuItemTagSearch_Click"/>
            <MenuItem Header=""
                      Name="AnzeigeDummy"/>
        </Menu>
        <Grid Margin="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>
            <Grid x:Name="GrdSearch"
                  Grid.Row="0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Label Grid.Column="0"
                       VerticalAlignment="Center"
                       VerticalContentAlignment="Center"
                       FontSize="12">
                    Suche:
                </Label>
                <TextBox x:Name="TxtBxSearchPattern"
                         Margin="10,0,10,0"
                         Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="14"
                         TextChanged="TxtBxSearchPattern_TextChanged"/>
                <Button x:Name="BtnSearchPatternEmpty"
                        Grid.Column="2"
                        Padding="2,3"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        Click="BtnSearchPatternEmpty_Click">
                    Suche leeren
                </Button>
            </Grid>

            <DataGrid Name="DataGridTags"
                      ItemsSource="{Binding Path=AllTags}"
                      AutoGenerateColumns="False"
                      Grid.Row="1"
                      CanUserAddRows="false"
                      HeadersVisibility="Column"
                      Margin="0,0,0,5"
                      SelectedItem="{Binding SelectedTag, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="dataGridTextNumber"
                                        Header="Id"
                                        IsReadOnly="True"
                                        Binding="{Binding Id}"
                                        Width="Auto"/>
                    <DataGridTextColumn Header="Tag"
                                        IsReadOnly="True"
                                        Binding="{Binding Designation}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Popup x:Name="PopupInputNewTag"
               Placement="Mouse"
               StaysOpen="False">
            <Border BorderBrush="Black"
                    BorderThickness="1"
                    Background="White"
                    Padding="10">
                <StackPanel>
                    <TextBox x:Name="InTxtBoxNewTag"
                             Background="LightGreen"
                             Width="200"
                             Margin="0,0,0,10"
                             TextChanged="InputTextBox_TextChanged"/>
                    <Button x:Name="BtnPopUp"
                            Content="OK"
                            Click="BtnPopUp_Click"/>
                </StackPanel>
            </Border>
        </Popup>
    </DockPanel>
</Window>
